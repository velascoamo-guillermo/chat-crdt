+#import <objc/runtime.h>
 #import "react-native-libsodium.h"
 
+// React Native 0.88 removed the RCTCxxBridge class. In bridgeless mode the
+// bridge handed to interop modules is an RCTBridgeProxy, which still exposes
+// the JSI runtime via -runtime (not declared in its public header).
+// RCTBridgeProxy is an NSProxy, so -respondsToSelector: is forwarded and
+// reports NO for -runtime; check the proxy's own class instead.
+@protocol LibsodiumRuntimeProvider <NSObject>
+- (void *)runtime;
+@end
+
 @implementation Libsodium
 
 @synthesize bridge=_bridge;
@@ -13,14 +23,20 @@ @implementation Libsodium
