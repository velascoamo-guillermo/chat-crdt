{
  "name": "chat-crdt",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "dev": "bun run infra:up && bun --filter @chat-crdt/server dev",
    "dev:all": "bun run infra:up && turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck"
  },
  "packageManager": "bun@1.2.20",
  "trustedDependencies": ["unrs-resolver"],
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "eslint-config-expo": "^56.0.4",
    "globals": "^17.6.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.61.0"
  }
}
