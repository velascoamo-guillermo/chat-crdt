  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun-types"],
    "paths": {
      "@chat-crdt/shared": ["../../packages/shared/src/index.ts"],
      "@chat-crdt/sync-engine": ["../../packages/sync-engine/src/index.ts"]
    }
  },
  "include": ["src/**/*.test.ts"]
}
