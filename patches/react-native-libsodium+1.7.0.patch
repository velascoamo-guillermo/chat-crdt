+  id bridge = self.bridge;
+  if (!bridge || !class_respondsToSelector(object_getClass(bridge), @selector(runtime))) {
+    RCTLogInfo(@"libsodium install failure: bridge does not expose a JSI runtime");
+    return nil;
+  }
+
+  void *runtime = [(id<LibsodiumRuntimeProvider>)bridge runtime];
+  if (!runtime) {
+    RCTLogInfo(@"libsodium install failure: no JSI runtime");
     return nil;
   }
 
