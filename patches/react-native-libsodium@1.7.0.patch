diff --git a/node_modules/react-native-libsodium/libsodium/build/libsodium-apple/tvos/include/sodium/crypto_aead_aes256gcm.h b/libsodium/build/libsodium-apple/tvos/include/sodium/crypto_aead_aes256gcm.h
