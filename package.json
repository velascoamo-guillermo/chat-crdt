{
  "name": "chat-crdt",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "dev": "bun run infra:up && bun --filter @chat-crdt/server dev",
    "dev:all": "bun run infra:up && turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint"
  },
  "packageManager": "bun@1.2.20",
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  }
}
