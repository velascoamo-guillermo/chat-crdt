{
  "expo": {
    "name": "chat-crdt",
    "slug": "chat-crdt",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "chatcrdt",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.chatcrdt.app"
    },
    "android": {
      "package": "com.chatcrdt.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
