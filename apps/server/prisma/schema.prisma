// Prisma v5 — pinned at ^5; v6+ requires prisma.config.ts and has breaking CLI changes
generator client {
  provider = "prisma-client-js"
  // "native" covers local dev. The Docker image (infra/k8s Dockerfile builds
  // on oven/bun:*-alpine, runs on node:20-alpine) needs its own targets
  // because builder and runtime Alpine bases disagree on OpenSSL major
  // version — both arm64 (this machine, used for the local kind validation
  // in this ticket) and x64 (Prisma's musl target naming only suffixes the
  // architecture for arm; x64 is just "linux-musl-openssl-*") are listed so
  // the same committed Dockerfile also produces a working image for anyone
  // building on/for an x64 host, e.g. CI or a future GKE node pool.
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-arm64-openssl-1.1.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(uuid())
  email       String       @unique
  username    String       @unique
  password    String       @db.VarChar(255)
  createdAt   DateTime     @default(now())
  memberships RoomMember[]
  // ADR-010: X25519 public half, published at registration or lazily via
  // PUT /users/me/public-key. publicKeyFp is a hash of publicKey, used to
  // detect stale RoomKeyGrant rows after a reinstall (see RoomKeyGrant).
  publicKey   String?
  publicKeyFp String?
  keyGrants   RoomKeyGrant[]
}

model Room {
  id           String       @id @default(uuid())
  name         String       @unique
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  yjsState     Bytes?
  memberships  RoomMember[]
  // ADR-010: 0 = E2EE not enabled for this room. Enabling (0 -> 1) and every
  // rotation thereafter goes through the same atomic epoch claim in
  // POST /rooms/:id/keys.
  currentKeyId Int          @default(0)
  keyGrants    RoomKeyGrant[]
}

// ADR-010: one row per (member, epoch) pair that member has actually been
// granted. recipientKeyFp records the fingerprint the uploader actually
// sealed against (verbatim, not server-derived) so a grant sealed to a
// since-replaced publicKey stops matching User.publicKeyFp and is correctly
// re-offered via GET /rooms/:id/keys/pending instead of silently stranding
// the member.
model RoomKeyGrant {
  roomId         String
  userId         String
  keyId          Int
  wrappedKey     String
  recipientKeyFp String
  createdAt      DateTime @default(now())
  room           Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId, keyId])
  @@index([userId])
}

model RoomMember {
  roomId    String
  userId    String
  role      String   @default("member")
  joinedAt  DateTime @default(now())
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([userId])
}
