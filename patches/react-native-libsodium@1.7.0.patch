+               size_t blocksize, size_t max_buflen) __attribute__((nonnull(2)));
+
+SODIUM_EXPORT
+int sodium_unpad(size_t *unpadded_buflen_p, const unsigned char *buf, size_t padded_buflen,
+                 size_t blocksize) __attribute__((nonnull(2)));
