{
  "name": "@chat-crdt/server",
  "version": "0.0.1",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "test": "jest --ci --forceExit && bun run test:bench",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p bench/tsconfig.json",
    "db:generate": "prisma generate",
    "bench": "bun run bench/run.ts",
    "test:bench": "bun test bench/"
  },
  "dependencies": {
    "@chat-crdt/shared": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-ws": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.0.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^5.6.0",
    "lib0": "^0.2.109",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.2",
    "ws": "^8.18.0",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.27",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@prisma/client": "^5",
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^29.0.0",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/ws": "^8.18.0",
    "bun-types": "^1.2.20",
    "jest": "^29.0.0",
    "prisma": "^5",
    "ts-jest": "^29.4.9"
  }
}
