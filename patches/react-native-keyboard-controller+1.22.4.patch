@@ -0,0 +1,85 @@
+// chat-crdt patch: no RN imports, so the app's bun tests can cover it.
+
+/**
+ * Scroll offset with the previous keyboard shift undone: the base the next
+ * shift is applied to. iOS can send two keyboard starts back to back (e.g.
+ * 320 then 347 when the keyboard returns after a modal), and the first
+ * shift's scroll lands a frame later, so `scroll` still reads the old offset.
+ * While a shift is pending, unwind from the offset it commanded instead.
+ */
+export const getUnwoundScroll = ({
+  scroll,
+  pendingOffset,
+  prevScrollEffective,
+  inverted,
+}: {
+  scroll: number;
+  pendingOffset: number | null;
+  prevScrollEffective: number;
+  inverted: boolean;
+}): number => {
+  "worklet";
+
+  const base = pendingOffset ?? scroll;
+
+  return inverted ? base + prevScrollEffective : base - prevScrollEffective;
+};
+
+/**
+ * Furthest offset the scroll view allows while `inset` is still the applied
+ * content inset: where a lift scrolled before its own inset commit stops.
+ */
+export const getClampFloor = ({
+  contentHeight,
+  layoutHeight,
+  inset,
+  inverted,
+}: {
+  contentHeight: number;
+  layoutHeight: number;
+  inset: number;
+  inverted: boolean;
+}): number => {
+  "worklet";
+
+  return inverted ? -inset : Math.max(contentHeight - layoutHeight + inset, 0);
+};
+
+/**
+ * The commanded lift offset if the scroll view clamped it, else null.
+ * A keyboard-show shift applied before its own contentInset commit stops at
+ * the previous inset's limit (`clampFloor`); by the transition's end the inset
+ * has landed and the offset can be re-applied. Anything else that left the
+ * scroll short is the reader's or the app's doing and is left alone: a drag
+ * during the transition, a scroll that doesn't rest at the floor, a scroll
+ * past the target (the composer's own end-scroll), or a hide (a shrinking
+ * inset can't clamp it short).
+ */
+export const getMissedLift = ({
+  scroll,
+  pendingOffset,
+  clampFloor,
+  opening,
+  userDragged,
+  inverted,
+}: {
+  scroll: number;
+  pendingOffset: number | null;
+  clampFloor: number;
+  opening: boolean;
+  userDragged: boolean;
+  inverted: boolean;
+}): number | null => {
+  "worklet";
+
+  if (pendingOffset === null || !opening || userDragged) {
+    return null;
+  }
+  if (Math.abs(scroll - clampFloor) >= 1) {
+    return null;
+  }
+
+  const shortBy = inverted ? scroll - pendingOffset : pendingOffset - scroll;
+
+  return shortBy >= 1 ? pendingOffset : null;
+};
