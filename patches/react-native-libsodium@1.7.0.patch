diff --git a/ios/Libsodium.mm b/ios/Libsodium.mm
index fbc745de0b351ca6193930a5682e5fa44589e8bf..e417b8ea97caaf644e99db6d556e142fb4c97497 100644
--- a/ios/Libsodium.mm
+++ b/ios/Libsodium.mm
@@ -4,6 +4,13 @@
 #import <React/RCTLog.h>
 #import "react-native-libsodium.h"
 
+// React Native 0.88 removed the RCTCxxBridge class. In bridgeless mode the
+// bridge handed to interop modules is an RCTBridgeProxy, which still exposes
+// the JSI runtime via -runtime (not declared in its public header).
+@protocol LibsodiumRuntimeProvider <NSObject>
+- (void *)runtime;
+@end
+
 @implementation Libsodium
 
 @synthesize bridge=_bridge;
@@ -13,14 +20,20 @@ @implementation Libsodium
 RCT_EXPORT_BLOCKING_SYNCHRONOUS_METHOD(install) {
 
   RCTLogInfo(@"installing libsodium");
-  RCTCxxBridge *cxxBridge = (RCTCxxBridge *)self.bridge;
-  if (!cxxBridge.runtime) {
-    RCTLogInfo(@"libsodium install failure: no cxx bridge runtime");
+  id bridge = self.bridge;
+  if (![bridge respondsToSelector:@selector(runtime)]) {
+    RCTLogInfo(@"libsodium install failure: bridge does not expose a JSI runtime");
+    return nil;
+  }
+
+  void *runtime = [(id<LibsodiumRuntimeProvider>)bridge runtime];
+  if (!runtime) {
+    RCTLogInfo(@"libsodium install failure: no JSI runtime");
     return nil;
   }
 
-  RCTLogInfo(@"calling installLibsodium with cxx bridge runtime");
-  ReactNativeLibsodium::installLibsodium(*(facebook::jsi::Runtime *)cxxBridge.runtime);
+  RCTLogInfo(@"calling installLibsodium with JSI runtime");
+  ReactNativeLibsodium::installLibsodium(*(facebook::jsi::Runtime *)runtime);
   return nil;
 }
 
