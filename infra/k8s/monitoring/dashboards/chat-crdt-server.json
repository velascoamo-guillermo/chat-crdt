{
  "title": "chat-crdt server",
  "uid": "chat-crdt-server",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "tags": [
    "chat-crdt",
    "sync-server"
  ],
  "panels": [
    {
      "id": 1,
      "title": "WS connections (per pod)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": null,
      "targets": [
        {
          "expr": "ws_connections",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Rooms loaded (per pod)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": null,
      "targets": [
        {
          "expr": "rooms_loaded",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Message rate by type",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": null,
      "targets": [
        {
          "expr": "sum(rate(messages_total[1m])) by (type)",
          "legendFormat": "{{type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Redis fan-out bytes/sec",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": null,
      "targets": [
        {
          "expr": "sum(rate(fanout_bytes_total[1m]))",
          "legendFormat": "bytes/sec",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Persist duration \u2014 P95",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": null,
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(persist_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "yjsState size per room (ADR-009 1MB line)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": null,
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1000000
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "yjs_state_bytes",
          "legendFormat": "{{roomId}} ({{pod}})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Rooms loaded \u2014 total across instances",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 24
      },
      "datasource": null,
      "targets": [
        {
          "expr": "sum(rooms_loaded)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "WS connections \u2014 total across instances",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 24
      },
      "datasource": null,
      "targets": [
        {
          "expr": "sum(ws_connections)",
          "refId": "A"
        }
      ]
    }
  ]
}
